# Secrets — never committed, ever
*.kdbx
*.kdbx.bak
*.kdbx-*
.env
.env.*
*.pem
*.key
secrets/
vault/

# Rust build output
/target

# Ferryman's attachment: this machine's config, its synced channel, and its
# PRIVATE SIGNING KEY. None of it belongs in the work repository - committing
# .ferryman/keys would publish an identity every machine in your fleet trusts.
/.ferryman/
